# PostgreSQL connection
# Production (with SSL):
DATABASE_URL=postgresql://tender_user:password@localhost:5432/tender_db?sslmode=require
# Local development (without SSL):
# DATABASE_URL=postgresql://tender_user:dev_password@localhost:5432/tender_db?sslmode=disable

# B2B-Center credentials
# Note: if password contains special chars (>, *, ', :, ) etc.) copy carefully
B2BCENTER_USERNAME=your@email.com
B2BCENTER_PASSWORD=yourpassword

# Bidzaar collection uses a public integrator endpoint; no credentials are required.
# For V3 analysis of private files, run: PYTHONPATH=src python scripts/bidzaar_login.py

# Optional: paths (defaults shown)
# DATA_DIR=data
# FILTERS_DIR=filters

# Optional: pipeline tuning
# QUALIFICATION_THRESHOLD=50
# COLLECTION_MAX_RETRIES=3
# COLLECTION_RETRY_BASE_SEC=1.0

# Telegram notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_IDS=123456789,987654321
WEB_BASE_URL=https://your-vps-domain.com

# Email digest (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@email.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@your-domain.com
EMAIL_RECIPIENTS=user1@company.com,user2@company.com
# DIGEST_HOURS=24
