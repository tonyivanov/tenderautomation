# ═══════════════════════════════════════════════════════════════════════════
# TenderAutomation — production environment variables
# Copy: cp .env.production.example .env
# Edit:  vim .env
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=change_me_to_strong_random_password_64_chars
POSTGRES_DB=tender_db

# ── Application ────────────────────────────────────────────────────────────
APP_PORT=8000

# ── B2B-Center credentials ─────────────────────────────────────────────────
B2BCENTER_USERNAME=your@email.com
B2BCENTER_PASSWORD=yourpassword

# Bidzaar collection uses the public integrator endpoint. For private files,
# create data/bidzaar_state.json and data/bidzaar_token.json with bidzaar_login.py.

# ── Telegram notifications (optional) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
WEB_BASE_URL=https://your-server.com

# ── Pipeline cron schedule (crontab format) ─────────────────────────────────
# Default: every 6 hours
PIPELINE_CRON_SCHEDULE=0 */6 * * *
# Examples:
#   Every hour:    0 * * * *
#   Every 3 hours: 0 */3 * * *
#   Twice daily:   0 8,20 * * *
#   Daily at 6 AM: 0 6 * * *
